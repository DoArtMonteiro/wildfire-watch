{
  "name": "wildfire-watch",
  "main": "workers/app-entry.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FIRMS_CACHE",
      "id": "6f6588ad3c434c3aad5767d50f91f730"
    }
  ],
  "triggers": {
    // Hourly at :00: FIRMS only. Four times an hour from :05: ANEPC, then the daily
    // summary when due. Each source runs in its own invocation, with its own CPU time.
    // Keep in step with FIRMS_CRON and OPERATIONAL_CRON in workers/scheduled.ts.
    "crons": ["0 * * * *", "5,20,35,50 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
